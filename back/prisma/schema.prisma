generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  password           String
  profile            CompanyProfile?
  requests           ContentRequest[]
  credits            Credit[]
  subscriptionPlan   SubscriptionPlan?   @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionPlanId Int?
}

model CompanyProfile {
  id         Int     @id @default(autoincrement())
  name       String
  category   String
  location   String
  instagram  String?
  facebook   String?
  tiktok     String?
  companyId  Int     @unique
 company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ContentRequest {
  id             String        @id @default(uuid())
  company        Company       @relation(fields: [companyId], references: [id])
  companyId      Int
  category       String
  format         String        // Post, Historia, Reel
  duration       Int
  credits        Int
  createdAt      DateTime      @default(now())
  suggestedCCs   SuggestedCC[]
}

model SuggestedCC {
  id               String          @id @default(uuid())
  contentRequest   ContentRequest  @relation(fields: [contentRequestId], references: [id])
  contentRequestId String
  creator          Creator         @relation("CreatorSuggestedCC", fields: [creatorId], references: [id])
  creatorId        String
}

model Creator {
  id        String     @id @default(cuid())
  name      String
  location  String
  instagram String?    
  facebook  String?    
  tiktok    String?    
  categories Category[] @relation("CategoryCreators")
  suggestedCCs SuggestedCC[] @relation("CreatorSuggestedCC")  // Aquí agregamos la relación inversa
}

model Category {
  id        String     @id @default(uuid())
  name      String
  creators  Creator[]  @relation("CategoryCreators")
}


model Credit {
  id         String     @id @default(uuid())
  company    Company    @relation(fields: [companyId], references: [id])
  companyId  Int
  amount     Int
  type       String     // Ej: "used", "added"
  createdAt  DateTime   @default(now())
}

model SubscriptionPlan {
  id          Int       @id @default(autoincrement())
  name        String
  creditLimit Int
  price       Float
  companies   Company[]
}
